  "priorities": [
    {
      "rank": 1,
      "area": "Bloomwild",
      "evidence": [
        "landing [258,696]",
        "entry [258,640]",
        "falls [780,700]"
      ],
      "issue": "Huge straight-edged sage shade fields cut across meadow as overlapping geometric polygons; pasted planes undermine otherwise detailed rooted trees and ruins.",
      "fix": "Reshape field edges into authored irregular turf/dapple masses tied to roots and waterworks, reduce value jump, retain calm open paths.",
      "source": "src/regions/bloomwild/paint.rs landing_fields/authored patches and preserve_fields path",
      "owner": "root"
    },
    {
      "rank": 2,
      "area": "Summit",
      "evidence": [
        "arena [720,520]",
        "dais [720,280]",
        "campaign10651,11046,11852,12628"
      ],
      "issue": "Arena reads as one nearly uniform blue slab; enormous rectangular tile grid gives no meaningful approach or sacred focal structure.",
      "fix": "Low-contrast nested radial/constellation masonry, fragmented outer inlay and grounded localized wear; keep combat center calm and emissive attack cues dominant.",
      "source": "src/regions/summit/paint.rs native_floor/arena_top/seal",
      "owner": "broad_beauty_audit_round6"
    },
    {
      "rank": 3,
      "area": "Glasswater",
      "evidence": [
        "island [500,440]",
        "gallery [550,102]",
        "grove [1200,230]",
        "shallow-grove [1120,280]",
        "campaign4014,4861,5425"
      ],
      "issue": "Every crystal has an identical blue circular halo, visibly exposing point-light primitives; open shore floors are almost empty and waterworks lack localized focal detail.",
      "fix": "Motivate light footprint with source-aware floor facets/native receiving geometry and existing occlusion; add a few restrained wet ledge catches and crystal reflection accents.",
      "source": "src/regions/glasswater.rs decor draw; src/regions/glasswater/paint.rs shore_and_reflections; place.rs light setup",
      "owner": "broad_beauty_audit_round6"
    },
    {
      "rank": 4,
      "area": "Title",
      "evidence": [
        "title/f00240.png"
      ],
      "issue": "Headland now continues off screen but left sky is broadly flat and distant geographic scale weak.",
      "fix": "Quiet distant shelves/landforms with varied depths and a coherent horizon, preserving text contrast and headland road.",
      "source": "src/regions/bloomwild/sky.rs and title_garden in src/regions/bloomwild.rs",
      "owner": "root"
    },
    {
      "rank": 5,
      "area": "Bloomwild architecture",
      "evidence": [
        "temple [1056,464]",
        "altar [408,176]",
        "campaign1258,1569,3124"
      ],
      "issue": "Pillar+drum pairing repeats in near-symmetric rings; good individual assets but shrine feels like a layout kit.",
      "fix": "Use grounded asymmetric rubble/moss/wear accents around selected bases or remove redundant paired drums; preserve lanes and existing completed base art.",
      "source": "src/regions/bloomwild/ruins.rs placements and paint slabs",
      "owner": "root decision"
    },
    {
      "rank": 6,
      "area": "Cinder",
      "evidence": [
        "foundry [621,510]",
        "press [621,460]",
        "canal-bridge [880,616]",
        "campaign7879,8140,8926"
      ],
      "issue": "Lava is now strongest environmental material, but foundry floor and ash stretches are sterile compared with molten detail; tiny repeated lone fins lack scene storytelling.",
      "fix": "Authored cold slag bands/rubble/staining at walls and former work sites, one or two readable focal industrial remnants, cooler quiet route margins rather than extra sparks everywhere.",
      "source": "src/regions/cinder/paint.rs ground/foundry/detail passes; field.rs placement",
      "owner": "root decision"
    },
    {
      "rank": 7,
      "area": "Bloomwild waterworks",
      "evidence": [
        "falls [780,700]",
        "upper-bridge [712,274]",
        "lower-bridge [840,590]",
        "falls-impact [712,356]"
      ],
      "issue": "Water plane is coherent but every bank uses a similar broad band and each pale bridge is an almost identical undecorated slab; outlet column still visually dominant and mechanical.",
      "fix": "Localized damp stones/moss at bridge abutments, fewer bright continuous bank lines, varied broken water catches and thin anchored spray only where dropping.",
      "source": "src/regions/bloomwild/paint.rs waterworks and dynamic waterfall draw",
      "owner": "root decision"
    },
    {
